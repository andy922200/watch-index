  "sourceDiscovery": {
    "method": "英國官方站與既有 HK／TW 站共用同一 Next.js 前端與 Magento GraphQL 後端（僅 store/lang 不同：en_gb / en-gb）。/gb/watches 不是有效入口（回傳 404），實際入口為 /en-gb/watches。/en-gb/watches 的 SSR __NEXT_DATA__ 含 total_count=806 與第 1 頁 24 筆；htmlLang=en-gb；category_uid 篩選值沿用 'NA=='（與 TW/HK 相同的「腕錶」分類 uid，三個市場共用同一商品目錄樹，僅 store/lang 顯示不同語系與價格）。點擊「顯示更多結果」對應的官方請求為同源 GET https://www.longines.com/api/graphql?operationName=ProductList，帶 store: en_gb、lang: en-gb 標頭；本次先嘗試沿用既有 HK evidence 中記錄的完整 ProductList 查詢文字重放，因該文字含未被 ProductList 實際引用的片段（於 GB 站現行伺服器版本被判定為驗證錯誤）而失敗，改用精簡後僅含實際使用片段與所需欄位的 ProductListLite 查詢，欄位命名與 category_uid 篩選值仍完全取自官方頁面本身。",
    "officialEndpoints": [
      "https://www.longines.com/en-gb/watches",
      "https://www.longines.com/api/graphql?operationName=ProductListLite",
      "https://www.longines.com/en-gb/watches/{family}",
      "https://www.longines.com/en-gb/p/{url_key}",
      "https://www.longines.com/api/graphql (ProductAttributes／StoreConfig，經商品頁 __NEXT_DATA__.props.pageProps.fallback 讀取)",
      "https://www.longines.com/api/graphql?operationName=ProductListCount（本次為子系列 total_count 對帳精簡查詢）"
    ],
    "structuredFieldsUsed": [
      "products.total_count / page_info（官方總數與分頁）",
      "items[].sku（完整點分參考號）",
      "items[].url_key / name / tag（NEW／BESTSELLER 標示）",
      "items[].categories[].url_path／uid（家族／子系列歸屬與 uid，供子系列 total_count 對帳）",
      "items[].preferred_category{name,url_path}（家族／子系列官方顯示名稱與唯一歸屬）",
      "items[].case_dimension、case_material、dial_color（後兩者經 ProductAttributes(en-gb) attributeMetadata.items 標籤對應）",
      "items[].base_price {value, value_formatted, currency} / special_price",
      "items[].stock_status（IN_STOCK／OUT_OF_STOCK，僅供觀察記錄，不影響 listingStatus 判定）"
    ]
